# Copy to .env.local and fill in from your Supabase project (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Never expose to the browser. Used by scripts/seed.ts, invites and webhooks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL of the app (used in invite emails and redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Zoho Books (optional until the sync is enabled). Indian data centre domains shown.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
ZOHO_API_DOMAIN=https://www.zohoapis.in
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.in
# Shared secret the Zoho webhook must send in the x-webhook-secret header
ZOHO_WEBHOOK_SECRET=

# Keka API (Settings → API access): used by "Sync from Keka" and mark-paid write-back
KEKA_COMPANY=your-subdomain
KEKA_ENVIRONMENT=keka
KEKA_CLIENT_ID=
KEKA_CLIENT_SECRET=
KEKA_API_KEY=
# Integer Keka uses for a paid claim in PUT /expense/claims (undocumented; default 1)
KEKA_PAID_STATUS=1

# Keka webhook (Settings → Event Triggers): send header x-webhook-secret with this value
KEKA_WEBHOOK_SECRET=
